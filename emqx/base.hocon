mqtt {
  peer_cert_as_clientid = disabled
  peer_cert_as_username = pem
  max_packet_size = 256KB
  max_inflight = 32
  retry_interval = 30s
  session_expiry_interval = 1h
  keepalive_multiplier = 1.5
}

listeners.tcp.default {
  enable = false
}

listeners.ws.default {
  enable = false
}

listeners.ssl.default {
  enable = false
}

listeners.wss.default {
  enable = false
}

listeners.ssl.device {
  bind = "0.0.0.0:8883"
  enable_authn = quick_deny_anonymous
  max_connections = 10000
  max_conn_rate = "200/s"
  ssl_options {
    cacertfile = "/opt/emqx/etc/algaguard-pki/device-ca/ca.crt"
    certfile = "/opt/emqx/etc/algaguard-pki/emqx/tls.crt"
    keyfile = "/opt/emqx/etc/algaguard-pki/emqx/tls.key"
    verify = verify_peer
    fail_if_no_peer_cert = true
    versions = ["tlsv1.3", "tlsv1.2"]
  }
}

listeners.ssl.internal {
  bind = "0.0.0.0:8884"
  enable_authn = false
  max_connections = 1000
  max_conn_rate = "100/s"
  ssl_options {
    cacertfile = "/opt/emqx/etc/algaguard-pki/service-ca/ca.crt"
    certfile = "/opt/emqx/etc/algaguard-pki/emqx/tls.crt"
    keyfile = "/opt/emqx/etc/algaguard-pki/emqx/tls.key"
    verify = verify_peer
    fail_if_no_peer_cert = true
    versions = ["tlsv1.3", "tlsv1.2"]
  }
}

authorization {
  no_match = deny
  deny_action = ignore
  cache {
    max_size = 32
    ttl = 5s
  }
  sources = [{
    type = file
    enable = true
    path = "/opt/emqx/etc/acl.conf"
  }]
}

# Drives the web/mobile dashboards' online/offline device status: on every
# device-listener client connect/disconnect, tell device-service so it can
# populate device_status_projection (previously nothing did, so every device
# always showed offline regardless of whether it was actually connected).
# __BROKER_DEVICE_AUTH_TOKEN__ is substituted by scripts/render-emqx-config.mjs
# before this file is mounted -- EMQX's rule-engine action config does not
# support ${ENV_VAR} interpolation or EMQX_A__B__C env overrides (verified
# empirically), unlike the core listener/authentication config above.
connectors.http.device_status {
  url = "http://device-service:3000"
  connect_timeout = "5s"
  pool_size = 4
  enable = true
}

actions.http.device_connected {
  connector = "device_status"
  parameters {
    method = "put"
    path = "/v1/internal/devices/${clientid}/status"
    headers {
      "content-type" = "application/json"
      "authorization" = "Bearer __BROKER_DEVICE_AUTH_TOKEN__"
    }
    body = "{\"observedAt\": \"${occurred_at}\", \"status\": {\"online\": true}}"
  }
  resource_opts {
    request_ttl = "5s"
  }
}

actions.http.device_disconnected {
  connector = "device_status"
  parameters {
    method = "put"
    path = "/v1/internal/devices/${clientid}/status"
    headers {
      "content-type" = "application/json"
      "authorization" = "Bearer __BROKER_DEVICE_AUTH_TOKEN__"
    }
    body = "{\"observedAt\": \"${occurred_at}\", \"status\": {\"online\": false}}"
  }
  resource_opts {
    request_ttl = "5s"
  }
}

rule_engine.rules.device_connected {
  # No clientid filter: only clients holding a device-CA-signed certificate
  # can complete this listener's mTLS handshake at all, and that
  # certificate's CN is always the device_id (see create_csr() in the
  # firmware), so every clientid reaching this rule is already an AG-XXXXXX.
  sql = "SELECT clientid, now_rfc3339() as occurred_at FROM \"$events/client_connected\""
  actions = ["http:device_connected"]
  enable = true
}

rule_engine.rules.device_disconnected {
  sql = "SELECT clientid, now_rfc3339() as occurred_at FROM \"$events/client_disconnected\""
  actions = ["http:device_disconnected"]
  enable = true
}
