{
  "realm": "algaguard",
  "enabled": true,
  "displayName": "AlgaGuard Development",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "OWNER" },
      { "name": "ADMIN" },
      { "name": "OPERATOR" },
      { "name": "VIEWER" }
    ]
  },
  "clients": [
    {
      "clientId": "algaguard-api",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "algaguard-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://localhost:8443/auth/callback",
        "https://algaguard.bosilu.dev/auth/callback"
      ],
      "webOrigins": [
        "https://localhost:8443",
        "https://algaguard.bosilu.dev"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://localhost:8443/dashboard##https://algaguard.bosilu.dev/dashboard"
      }
    },
    {
      "clientId": "algaguard-mobile",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["com.algaguard.mobile:/oauthredirect"]
    },
    {
      "clientId": "algaguard-e2e",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "algaguard-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "algaguard-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "algaguard-access-service",
      "clientAuthenticatorType": "client-secret",
      "secret": "${ALGAGUARD_ACCESS_SERVICE_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "algaguard-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "algaguard-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "algaguard-device-service",
      "clientAuthenticatorType": "client-secret",
      "secret": "${ALGAGUARD_DEVICE_SERVICE_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "algaguard-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "algaguard-api",
            "access.token.claim": "true",
