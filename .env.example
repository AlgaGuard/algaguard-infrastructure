COMPOSE_PROJECT_NAME=algaguard-demo
PUBLIC_WEB_URL=https://localhost:8443
PUBLIC_API_URL=https://localhost:8443/api
PUBLIC_WSS_URL=wss://localhost:8443/realtime
PUBLIC_KEYCLOAK_URL=https://localhost:8443/auth
KEYCLOAK_RELATIVE_PATH=/auth
PUBLIC_MQTT_HOST=localhost
PUBLIC_MQTT_PORT=8883
PUBLIC_OTA_BASE_URL=https://localhost:8443/api
PUBLIC_TLS_HOSTS=localhost,127.0.0.1
POSTGRES_DB=algaguard
POSTGRES_USER=algaguard
POSTGRES_PASSWORD=development-only-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=development-only-change-me
MINIO_ROOT_USER=algaguard-development
MINIO_ROOT_PASSWORD=development-only-change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=development-only-change-me
ALGAGUARD_ACCESS_SERVICE_SECRET=replace-with-access-service-secret
ALGAGUARD_DEVICE_SERVICE_SECRET=replace-with-device-service-secret
ALGAGUARD_MQTT_INGESTION_SERVICE_SECRET=replace-with-mqtt-ingestion-service-secret
ALGAGUARD_TELEMETRY_SERVICE_SECRET=replace-with-telemetry-service-secret
ALGAGUARD_REALTIME_SERVICE_SECRET=replace-with-realtime-service-secret
ALGAGUARD_PROFILE_SERVICE_SECRET=replace-with-profile-service-secret
ALGAGUARD_COMMAND_SERVICE_SECRET=replace-with-command-service-secret
ALGAGUARD_OTA_SERVICE_SECRET=replace-with-ota-service-secret
ALGAGUARD_FIRMWARE_RELEASE_SECRET=replace-with-firmware-release-secret
BROKER_DEVICE_AUTH_TOKEN=replace-with-32-character-broker-device-auth-token
EMQX_NODE_COOKIE=replace-with-development-emqx-node-cookie
ALGAGUARD_RUNTIME_UID=1000
ALGAGUARD_RUNTIME_GID=1000
HTTP_BODY_LIMIT=256kb
DEVICE_CERTIFICATE_VALIDITY_DAYS=90
DEVICE_BOOTSTRAP_TTL_SECONDS=600
DEVICE_BOOTSTRAP_MAX_ATTEMPTS=5
DEVICE_ROTATION_OVERLAP_SECONDS=300
DEVICE_BROKER_AUTH_CACHE_SECONDS=300
DEVICE_REVOCATION_EFFECTIVE_SECONDS=5
MQTT_MAX_PACKET_BYTES=262144
MQTT_MAX_SAMPLES_PER_BATCH=120
MQTT_QOS1_INFLIGHT=32
MQTT_KEEPALIVE_SECONDS=60
MQTT_SESSION_EXPIRY_SECONDS=3600
MQTT_RECONNECT_DELAY_MS=2000
MQTT_MAX_MESSAGES_PER_SECOND=200
OTA_HTTP_BODY_LIMIT_BYTES=262144
OTA_ASSIGNMENT_TTL_SECONDS=900
OTA_DOWNLOAD_URL_TTL_SECONDS=300
REALTIME_HTTP_BODY_LIMIT_BYTES=32768
WS_MAX_MESSAGE_BYTES=262144
WS_MAX_SUBSCRIPTIONS=50
WS_OUTBOUND_QUEUE_MAX=100
WS_CONNECTIONS_PER_MINUTE=20
WS_MESSAGES_PER_MINUTE=120
WS_HEARTBEAT_MS=30000
WS_IDLE_TIMEOUT_MS=90000
WS_BACKPRESSURE_BYTES=524288
WS_PREAUTH_BUFFER_MESSAGES=50
# Development-only feature gates are disabled unless a protected controller
# injects a bounded runtime override.
ALGAGUARD_ENABLE_QR_ONBOARDING=0
